<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Totem Detector de Incêndio - Monitorização</title>
  
  <!-- Leaflet CSS & JS para o Mapa -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    :root {
      --cor-fundo: #0f1720;
      --cor-cartao: #182430;
      --cor-texto: #e6edf3;
      --cor-texto-fraco: #93a1ad;
      --cor-normal: #2ecc71;
      --cor-alerta: #ff3300;
      --cor-borda: #26333f;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--cor-fundo);
      color: var(--cor-texto);
      padding: 24px;
      transition: background 0.5s ease;
    }

    /* Animação de Alerta Global */
    body.em-alerta { animation: pulsarFundo 1.5s infinite alternate; }
    @keyframes pulsarFundo {
      0% { background: #1a0500; }
      100% { background: #330a00; }
    }

    #banner-alerta {
      display: none;
      background: linear-gradient(90deg, #ff0000, #ff7700, #ff0000);
      color: white;
      padding: 18px;
      border-radius: 12px;
      margin-bottom: 20px;
      font-weight: 800;
      font-size: 1.2rem;
      text-align: center;
      box-shadow: 0 0 25px rgba(255, 68, 0, 0.8);
      animation: tremor 0.3s infinite;
    }

    @keyframes tremor {
      0% { transform: translate(0, 0); }
      25% { transform: translate(-2px, 2px); }
      50% { transform: translate(2px, -1px); }
      75% { transform: translate(-1px, -1px); }
      100% { transform: translate(0, 0); }
    }

    h1 { font-size: 1.5rem; margin: 0 0 4px 0; }
    .subtitulo { color: var(--cor-texto-fraco); margin-bottom: 24px; font-size: 0.9rem; }
    
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .cartao {
      background: var(--cor-cartao);
      border: 1px solid var(--cor-borda);
      border-radius: 12px;
      padding: 18px;
    }
    
    .cartao .rotulo { color: var(--cor-texto-fraco); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 8px; }
    .cartao .valor { font-size: 2rem; font-weight: 600; }
    .status-normal { color: var(--cor-normal); }
    .status-alerta { color: var(--cor-alerta); text-shadow: 0 0 10px rgba(255,51,0,0.6); }

    #map { width: 100%; height: 400px; border-radius: 12px; border: 1px solid var(--cor-borda); }
  </style>
</head>
<body>

  <h1>🔥 Totem Detector de Incêndio</h1>
  <div class="subtitulo">Monitorização LoRa em tempo real via Firebase Database</div>

  <div id="banner-alerta">🚨 🔥 ALERTA DE INCÊNDIO DETECTADO! 🔥 🚨</div>

  <div class="grid">
    <div class="cartao">
      <div class="rotulo">Localização</div>
      <div class="valor" id="valor-local">--</div>
    </div>
    <div class="cartao">
      <div class="rotulo">Gás (MQ-2)</div>
      <div class="valor" id="valor-gas">--</div>
    </div>
    <div class="cartao">
      <div class="rotulo">Temperatura</div>
      <div class="valor" id="valor-temp">-- °C</div>
    </div>
    <div class="cartao">
      <div class="rotulo">Sinal LoRa (RSSI)</div>
      <div class="valor" id="valor-rssi">-- dBm</div>
    </div>
    <div class="cartao">
      <div class="rotulo">Estado</div>
      <div class="valor" id="valor-status">--</div>
    </div>
  </div>

  <div id="map"></div>

<script>
  // URL do teu Firebase Realtime Database
  const URL_FIREBASE = "https://teste-79de3-default-rtdb.firebaseio.com/teste.json";

  const COORDENADAS = {
    "ete": { lat: -22.257827, lng: -45.703358, nome: "ETE FMC" },
    "neo": { lat: -23.545626, lng: -46.473748, nome: "Neo Química Arena" },
    "cachoeira": { lat: -22.353751, lng: -45.781747, nome: "Cachoeira de Minas" }
  };

  let map, marker, ultimoLocal = "";

  function inicializarMapa() {
    map = L.map('map').setView([-22.257827, -45.703358], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(map);
    marker = L.marker([-22.257827, -45.703358]).addTo(map);
  }

  function atualizarPosicaoMapa(localStr) {
    if (!localStr || localStr === ultimoLocal) return;
    const chave = localStr.toLowerCase();
    const ponto = COORDENADAS[chave] || COORDENADAS["ete"];

    if (ponto) {
      map.setView([ponto.lat, ponto.lng], 16);
      marker.setLatLng([ponto.lat, ponto.lng]).bindPopup(`<b>${ponto.nome}</b>`).openPopup();
      ultimoLocal = localStr;
    }
  }

  async function atualizarPainel() {
    try {
      const resp = await fetch(URL_FIREBASE);
      const dados = await resp.json();
      if (!dados) return;

      document.getElementById("valor-local").textContent = dados.local || "--";
      document.getElementById("valor-gas").textContent = dados.gas !== undefined ? dados.gas : "--";
      document.getElementById("valor-temp").textContent = (dados.temp !== undefined ? dados.temp : "--") + " °C";
      document.getElementById("valor-rssi").textContent = (dados.rssi !== undefined ? dados.rssi : "--") + " dBm";

      const statusEl = document.getElementById("valor-status");
      const banner = document.getElementById("banner-alerta");

      if (dados.alerta) {
        statusEl.textContent = "ALERTA 🔥";
        statusEl.className = "valor status-alerta";
        banner.style.display = "block";
        document.body.classList.add("em-alerta");
      } else {
        statusEl.textContent = "Normal";
        statusEl.className = "valor status-normal";
        banner.style.display = "none";
        document.body.classList.remove("em-alerta");
      }

      atualizarPosicaoMapa(dados.local);

    } catch (erro) {
      console.error("Erro ao carregar dados do Firebase:", erro);
    }
  }

  window.onload = () => {
    inicializarMapa();
    atualizarPainel();
    setInterval(atualizarPainel, 2000); // Atualiza os dados a cada 2 segundos
  };
</script>

</body>
</html>
